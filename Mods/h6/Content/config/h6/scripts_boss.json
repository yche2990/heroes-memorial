	"h6AiHint": {
		"implements": "spellEffect",
		"script": "spells/h6AiHint",
		"patches": [],
		"description": "H6 Memorial: AI valuation hint. Reports an equivalent value only during AI trial calculations; does nothing when actually cast",
		"schema": {
			"properties": {
				"type": {},
				"indirect": {},
				"optional": {},
				"mode": {
					"type": "string",
					"enum": [
						"allies",
						"dispel",
						"foes"
					],
					"description": "allies: each affected ally counts as the value of one of its normal attacks; dispel: number of beneficial spells on the target enemy; foes: number of enemy stacks affected"
				},
				"ratio": {
					"type": "number",
					"description": "multiplier of each share (times the value of one normal attack of the caster or of the ally), default 0.5"
				},
				"cap": {
					"type": "number",
					"description": "maximum number of shares counted, default 3"
				},
				"center": {
					"type": "string",
					"enum": [
						"target",
						"caster",
						"all"
					],
					"description": "foes: where to count enemies, default target"
				},
				"radius": {
					"type": "number",
					"description": "foes: how many hexes around target / caster, default 0 (with target, only the target itself)"
				},
				"small": {
					"type": "boolean",
					"description": "foes: count only single-hex enemies"
				},
				"melee": {
					"type": "boolean",
					"description": "foes: count only enemies that are not shooters"
				},
				"status": {
					"type": "string",
					"description": "foes: full name of the status spell; enemies immune to it or already under it are not counted"
				},
				"skip": {
					"type": "string",
					"description": "foes: enemies carrying this bonus type are not counted"
				},
				"bigFirst": {
					"type": "boolean",
					"description": "foes: also multiply by the target's value divided by the value of the largest enemy stack"
				},
				"proxyBonus": {
					"type": "object",
					"description": "allies: gives each affected ally one native bonus { type, subtype, val, turns } (only in the AI simulation)"
				}
			},
			"additionalProperties": false
		}
	}
}
